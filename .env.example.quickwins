# =============================================================================
# ETL Quick Wins - Rate Limiting & Batch Optimization Configuration
# =============================================================================
# Add these variables to your .env file to customize ETL performance

# Files API rate limiting (requests per minute) - Prevents 429 bursts
# Default: 5 RPM (= 12 seconds between requests across all workers)
# 
# How it works:
#   - All 8 download workers share a global rate limiter
#   - Prevents request bursts that trigger HTTP 429 (Too Many Requests)
#   - If API allows higher: increase to 10 for 2x faster downloads (6s between requests)
#   - If API is stricter: decrease to 3 for 20s between requests
#
# IMPORTANT: Match this to your actual API rate limit!
FILES_API_MAX_RPM=5

# Media Server batch DB updates (records per batch commit)
# Default: 50 files per batch commit
#
# Impact:
#   - Previously: 2 commits per file → 2000 commits per 1000 files
#   - Now: 50 files per batch → 20 commits per 1000 files
#   - 100x reduction in database commits
#
# Tuning:
#   - Higher (100): Fewer commits, faster (~15% improvement) but delayed durability
#   - Lower (10): More commits, slower but immediate durability
#   - Safe range: 10-100
BATCH_DB_SIZE=50

# IR ETL batch commit size (records per database commit)
# Default: 10 records per commit
#
# NOTE: This is different from media server batching
# Controls how many IR records are batched together before committing to DB
# 
# Trade-offs:
#   - Higher (100): Fewer WAL flushes, 20-30% speedup but delayed durability
#   - Lower (5): More commits, safety-critical use cases
BATCH_COMMIT_SIZE=10

# =============================================================================
# Performance Tuning Guide
# =============================================================================

# For maximum performance (non-critical data):
#   FILES_API_MAX_RPM=10     # Faster downloads (if API allows)
#   BATCH_DB_SIZE=100        # Aggressive batching
#   BATCH_COMMIT_SIZE=100    # Aggressive IR batching
#   Expected gain: 25-30% overall ETL speedup

# For balanced performance/safety (recommended):
#   FILES_API_MAX_RPM=5      # Default, prevents 429s
#   BATCH_DB_SIZE=50         # Moderate batching
#   BATCH_COMMIT_SIZE=10     # Safety-conscious IR batching
#   Expected gain: 10-15% overall ETL speedup

# For maximum durability (critical data):
#   FILES_API_MAX_RPM=3      # Conservative, avoids any API load
#   BATCH_DB_SIZE=10         # Minimal batching
#   BATCH_COMMIT_SIZE=5      # Per-record commits
#   Safety trade-off: slower but maximum data safety

# =============================================================================
# Monitoring & Troubleshooting
# =============================================================================

# Check if rate limiter is working:
#   grep "Enforce strict request pacing" etl_master/logs/*/files.log

# Check if 429 rate limits still occur (indicates FILES_API_MAX_RPM too high):
#   grep "API rate limited (429)" etl_master/logs/*/ir.log

# Check if batch commits are flushing properly:
#   grep "Flushed.*DB status updates" etl_master/logs/*/files_media_server.log

# Monitor database commit frequency during runs:
#   tail -f etl_master/logs/*/ir.log | grep -E "COMMIT|commit"

